<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ThePlayer.Application\ThePlayer.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <!--
    System.Diagnostics.PerformanceCounter is Windows-only by design; the Linux CPU reader
    uses /proc/stat instead. Referencing it unconditionally is safe - the package ships a
    net8.0 target that throws only if constructed on a non-Windows OS, and the reader is
    selected by RuntimeInformation at registration time so that never happens.
  -->
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
  </ItemGroup>

</Project>
