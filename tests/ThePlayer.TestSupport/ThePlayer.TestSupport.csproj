<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      It is a helper library, not a test project. Without this, `dotnet test` on the solution tries
      to run it as one - it references xunit but has no test host - and reports a confusing
      "testhost process exited with error" alongside the real results.
    -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThePlayer.Application\ThePlayer.Application.csproj" />
  </ItemGroup>

  <!--
    Not named *.Tests, so it does not inherit the shared test stack from
    Directory.Build.props. It needs xunit only for IAsyncLifetime on the fixtures.
  -->
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.2" />
  </ItemGroup>

</Project>
